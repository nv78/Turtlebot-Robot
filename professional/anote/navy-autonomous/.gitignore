# Navy Autonomous Robot - Git Ignore Configuration
# Excludes temporary files, build artifacts, and system-specific files

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Docker and Container Files
.dockerignore
docker-compose.override.yml
.env.local
.env.*.local

# ROS Build Artifacts
build/
devel/
install/
.catkin_workspace
*.bag
*.orig

# Python Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.cproject
.pydevproject

# Log Files
*.log
logs/
*.out

# Temporary Files
*.tmp
*.temp
.cache/
.pytest_cache/

# OS Generated Files
Thumbs.db
ehthumbs.db
Desktop.ini

# Backup Files
*.bak
*.backup
*.old

# Environment Variables
.env
.env.production
.env.development
.env.staging 